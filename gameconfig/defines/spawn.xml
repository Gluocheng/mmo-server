<module name="spawn">
	<bean name="Spawn" comment="刷怪点">
		<var name="id" type="int" comment="刷怪点id"/>
		<var name="feature" type="string" comment="玩法名"/>
		<var name="scene_id" type="int" comment="地图"/>
		<var name="line" type="int" comment="分线"/>
		<var name="monster_id" type="int" comment="怪物模板"/>
		<var name="x" type="float" comment="出生点x"/>
		<var name="y" type="float" comment="出生点y"/>
		<var name="z" type="float" comment="出生点z"/>
		<var name="count" type="int" comment="数量，1到4"/>
		<var name="respawn_ms" type="int" comment="复活毫秒"/>
	</bean>
	<table name="TbSpawn" value="Spawn" input="spawn.csv" comment="刷怪点表"/>
</module>
