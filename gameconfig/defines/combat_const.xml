<module name="combat_const">
	<bean name="CombatConst" comment="战斗常量">
		<var name="id" type="int" comment="固定 1"/>
		<var name="max_hp" type="int" comment="进场最大生命"/>
		<var name="tick_ms" type="int" comment="心跳毫秒"/>
		<var name="respawn_ms" type="int" comment="死亡后复活毫秒"/>
		<var name="frame_event_cap" type="int" comment="单包命中上限"/>
	</bean>
	<table name="TbCombatConst" value="CombatConst" input="combat_const.csv" comment="战斗常量表"/>
</module>
